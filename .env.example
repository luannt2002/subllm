# subllm — MẪU cấu hình. Chép thành .env (đã gitignore) rồi điền.
# Biến env có sẵn thắng giá trị trong file. Mọi biến (trừ SUBLLM_API_KEY) đều
# bắt buộc: thiếu hoặc sai là subllm dừng lúc khởi động và in tên biến.
# Cú pháp: KEY=VALUE, không dấu nháy, không chú thích cuối dòng; dòng # là
# chú thích.
#
# 🔒 Khoá để TRỐNG ở mẫu này chỉ điền trong .env (không commit):
#    - bí mật: API key, file credential (lộ tên tài khoản);
#    - dữ liệu của nhà cung cấp: endpoint, client ID, phiên bản, chuỗi beta,
#      User-Agent, tiền tố model.
#    Mẫu chỉ ghi giá trị do chính dự án quyết (host, port, thời gian, danh
#    sách provider…). Test TestEnvExampleProjectValuesOnly đỏ nếu ai điền giá
#    trị vào khoá 🔒.
#
# Provider tên <N> kiểu <T> đọc key <K> lần lượt ở:
#   SUBLLM_PROVIDER_<N>_<K> → SUBLLM_TYPE_<T>_<K> → SUBLLM_<K>

# --- subllm ---
# Host chỉ nhận loopback (127.0.0.1, ::1, localhost) — token là chìa khoá
# tài khoản, code từ chối địa chỉ khác.
SUBLLM_HOST=127.0.0.1
SUBLLM_PORT=18080
# 🔒 Trống = không kiểm key (chỉ hợp khi một mình bạn dùng máy). Đặt thì
# client gửi "Authorization: Bearer <key>"; /status và /v1/models cũng đòi key.
SUBLLM_API_KEY=
# Nghỉ bao lâu sau 429 khi upstream không gửi Retry-After.
SUBLLM_COOLDOWN=5m
# Trần một request upstream (tính cả lúc đọc stream), refresh token.
SUBLLM_TIMEOUT=5m
SUBLLM_REFRESH_MARGIN=5m
SUBLLM_REFRESH_TIMEOUT=30s

# --- Danh sách provider (mỗi provider = một tài khoản) ---
# Thứ tự = ưu tiên: nhiều provider cùng tiền tố model thì dùng cái đứng
# trước; dính 429 / lỗi tài khoản (401, 403, credential) thì failover sang
# cái kế. Client chọn đích danh bằng field "provider": "<tên>" (không
# failover). Tên chỉ gồm A-Z a-z 0-9 _. TYPE = giao thức có trong code:
# codex | claude.
SUBLLM_PROVIDERS=codex,claude

# --- provider "codex" (gói ChatGPT Plus/Pro, đăng nhập Codex CLI) ---
SUBLLM_PROVIDER_CODEX_TYPE=codex
# 🔒 tiền tố tên model của gói (model nào route về provider này)
SUBLLM_PROVIDER_CODEX_MODEL_PREFIX=
# 🔒 file auth của Codex CLI
SUBLLM_PROVIDER_CODEX_CRED_FILE=

# --- provider "claude" (gói Claude Pro/Max, đăng nhập Claude Code) ---
SUBLLM_PROVIDER_CLAUDE_TYPE=claude
# 🔒 tiền tố tên model của gói
SUBLLM_PROVIDER_CLAUDE_MODEL_PREFIX=
# 🔒 file credential của Claude Code
SUBLLM_PROVIDER_CLAUDE_CRED_FILE=

# --- giá trị chung kiểu codex ---
# 🔒 gốc backend, endpoint OAuth token, client ID, phiên bản client mà
#    backend đòi, header OpenAI-Beta, User-Agent
SUBLLM_TYPE_CODEX_BASE_URL=
SUBLLM_TYPE_CODEX_TOKEN_URL=
SUBLLM_TYPE_CODEX_CLIENT_ID=
SUBLLM_TYPE_CODEX_CLIENT_VERSION=
SUBLLM_TYPE_CODEX_ORIGINATOR=subllm
SUBLLM_TYPE_CODEX_BETA=
SUBLLM_TYPE_CODEX_USER_AGENT=

# --- giá trị chung kiểu claude ---
# 🔒 gốc Messages API, endpoint OAuth token, client ID, header
#    anthropic-version, header anthropic-beta (OAuth), User-Agent
SUBLLM_TYPE_CLAUDE_BASE_URL=
SUBLLM_TYPE_CLAUDE_TOKEN_URL=
SUBLLM_TYPE_CLAUDE_CLIENT_ID=
SUBLLM_TYPE_CLAUDE_API_VERSION=
SUBLLM_TYPE_CLAUDE_BETA=
SUBLLM_TYPE_CLAUDE_USER_AGENT=
SUBLLM_TYPE_CLAUDE_MAX_TOKENS=4096

# --- Ví dụ: thêm tài khoản Claude thứ hai — KHÔNG sửa code ---
# Mỗi file credential chỉ một provider giữ (trùng file → dừng khởi động).
# Dùng file của một tài khoản KHÔNG đang chạy trong Claude Code, vì refresh
# token xoay vòng: hai nơi cùng refresh một token là văng đăng nhập.
# SUBLLM_PROVIDERS=codex,claude,claude2
# SUBLLM_PROVIDER_CLAUDE2_TYPE=claude
# SUBLLM_PROVIDER_CLAUDE2_MODEL_PREFIX=<cùng tiền tố với provider claude>
# SUBLLM_PROVIDER_CLAUDE2_CRED_FILE=<file credential của tài khoản 2>
# Ghi đè riêng cho claude2: SUBLLM_PROVIDER_CLAUDE2_<KEY>, vd ..._MAX_TOKENS=8192
